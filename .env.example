# Supabase (https://supabase.com → project settings → API থেকে নিন)
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# প্রধান অ্যাডমিন (fixed — /admin লগইন; এই আইডি দিয়েই সাব-অ্যাডমিন/সংগ্রাহক তৈরি হবে)
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=admin123

# ডিফল্ট সংগ্রাহক (/collect লগইন — অ্যাডমিন প্যানেল থেকে নতুন সংগ্রাহকও তৈরি করা যায়)
VITE_COLLECTOR_USERNAME=collector
VITE_COLLECTOR_PASSWORD=collect123
